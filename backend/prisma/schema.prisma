generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./diet.db"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  age     Int    @default(25)
  gender  String @default("")
  height  Int    @default(170)
  weight  Int    @default(65)
  region  String @default("")
  habits  String @default("") // JSON array stored as string
  goals   String @default("") // JSON array stored as string

  messages  Message[]
  selections Selection[]
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  role      String   // "user" | "assistant"
  content   String
  user      User     @relation(fields: [userId], references: [id])
}

model Selection {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  type       String   // "food" | "exercise"
  name       String
  icon       String   @default("")
  calories   String   @default("")
  duration   String   @default("")
  burn       String   @default("")
  chosenAt   String   @default("")
  user       User     @relation(fields: [userId], references: [id])
}
